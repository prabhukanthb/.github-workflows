PORT=4000
JWT_SECRET=change-this-secret
# Telugu Kalyanamala only. Do not paste the New Kalyanamala URI or Cloudinary cloud.
# The database name in the path must be telugu-kalyanamala.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/telugu-kalyanamala
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set RESET_DB=1 to rebuild demo profiles on startup. Never set this on Vercel after families register.
